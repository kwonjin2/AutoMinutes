# =============================================================================
# AutoMinutes .env — copy to .env (or let `./setup.sh` do it) and fill in keys
# =============================================================================
#
# Minimum viable config (Gemini-summary-only, no uploads):
#
#   GEMINI_API_KEY=AIzaSy...your-real-key...
#
# That single line is enough — every Upload/Runtime entry below is OPTIONAL and
# is auto-skipped when blank. Run `npm run doctor` after editing to verify.
# =============================================================================


# ----- REQUIRED ---------------------------------------------------------------

# Google Gemini API key — used by summarize.js.
# Get a free key at https://ai.google.dev (Google AI Studio).
GEMINI_API_KEY=your_gemini_api_key_here


# ----- RECOMMENDED runtime flags (commonly tuned) -----------------------------

# whisper.cpp model name. `setup.sh` writes this line for you on first install.
# Allowed values: tiny / base / small / medium / large-v3 / large-v3-turbo (default).
# The weight file lives at whisper.cpp/models/ggml-<name>.bin.
# Quick validation tip: start with `tiny` (~39MB) to confirm the pipeline works
# end-to-end in <2 min, then bump up to `large-v3-turbo` for real meetings.
# WHISPER_MODEL=large-v3-turbo

# Transcription language (default: ko).
# "auto" = whisper.cpp auto-detection; or an ISO-639-1 code (e.g. ko / en / ja).
# Keep `ko` for Korean meetings; use `auto` or set explicitly for other languages.
# WHISPER_LANG=ko


# ----- OPTIONAL prompt customization ------------------------------------------

# Path to the Markdown prompt used by summarize.js (relative to the repo root).
# Default: prompts/default.md (clean OSS template, no team IDs).
# See prompts/mentoring.md for a fully-populated mentoring-session example.
# PROMPT_PATH=prompts/default.md


# ----- OPTIONAL upload targets (leave a group BLANK to auto-skip) -------------
# Each upload module checks its env group; if any var is missing the whole
# group is treated as "not configured" and the step is skipped with a log line.
# `npm run doctor` shows ⚠ for empty groups.

# Discord webhook for posting the summary as a message.
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Discord recording bot token (ONLY needed for `npm run record` auto-recording).
# This is your OWN bot's token — completely separate from DISCORD_WEBHOOK_URL above.
# See README "🎙️ Meeting recording" for how to create the bot.
# DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Notion integration (both vars required together).
# NOTION_TOKEN=your_notion_integration_token_here
# NOTION_DATABASE_ID=your_notion_database_id_here

# GitHub Wiki upload (all three required together).
# GITHUB_USERNAME=your_github_username_here
# GITHUB_PAT=your_github_personal_access_token_here
# GITHUB_REPO_NAME=your_repo_name_here


# ----- OPTIONAL safety flag ---------------------------------------------------

# Dry-run mode: when true, upload modules print payloads to stdout instead of
# sending them. Useful when iterating on prompts/outputs without spamming
# production channels.
# TEST_MODE=true
