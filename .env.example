# ===== Required =====

# Google Gemini API key — used by summarize.js
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Prompt customization (optional) =====

# Path to the Markdown prompt used by summarize.js.
# Default: prompts/default.md (clean OSS template, no team IDs).
# See prompts/mentoring.md for a fully-populated mentoring-session example
# you can copy and adapt. Path is resolved relative to the repo root.
# PROMPT_PATH=prompts/default.md

# ===== Upload targets (all optional — leave blank to auto-skip) =====

# Discord webhook for posting the summary
# DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Notion integration
# NOTION_TOKEN=your_notion_integration_token_here
# NOTION_DATABASE_ID=your_notion_database_id_here

# GitHub Wiki upload
# GITHUB_USERNAME=your_github_username_here
# GITHUB_PAT=your_github_personal_access_token_here
# GITHUB_REPO_NAME=your_repo_name_here

# ===== Runtime flags =====

# Dry-run mode: when true, upload modules print to console instead of sending.
# TEST_MODE=true

# whisper.cpp 모델 이름 (setup.sh 가 자동 기록).
# 가능한 값: tiny / base / small / medium / large-v3 / large-v3-turbo (기본)
# 파일은 whisper.cpp/models/ggml-<name>.bin 으로 다운로드됨.
# WHISPER_MODEL=large-v3-turbo

# 전사 언어 (기본 ko).
# "auto" = whisper.cpp 자동 감지, "ko"/"en"/"ja" 등 ISO-639-1 코드 직접 지정 가능.
# 한국어 회의가 주 시나리오면 ko 유지, 다국어/영어 회의면 auto 또는 해당 언어로 변경.
# WHISPER_LANG=ko
